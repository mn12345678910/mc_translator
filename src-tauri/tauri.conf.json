{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mc_translator",
  "version": "0.6.13",



  "identifier": "com.mctext.translator",

  "build": {
    "frontendDist": "../frontend"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Minecraft 模組翻譯工具",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
