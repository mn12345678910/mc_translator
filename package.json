{
  "name": "mc_translator",
  "version": "0.8.4",
  "description": "> [!NOTE] > 安全須知: > 本工具使用系統憑證管理鏈 (`keyring` crate) 對 API KEY 進行安全儲存，免除本地明文落盤，提昇跨平台安全性。",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:frontend": "vitest run",
    "dev": "vite frontend",
    "build": "vite build frontend --outDir ../dist",
    "preview": "vite preview frontend",
    "tauri": "tauri",
    "format": "prettier --write \"frontend/**/*.{html,js,css}\"",
    "lint": "eslint \"frontend/**/*.js\"",
    "check-tauri": "node tool/check_tauri_sync.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mn12345678910/mc_translator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mn12345678910/mc_translator/issues"
  },
  "homepage": "https://github.com/mn12345678910/mc_translator#readme",
  "devDependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@chenglou/pretext": "^0.0.1",
    "eslint": "^10.1.0",
    "happy-dom": "^20.8.8",
    "prettier": "^3.3.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
